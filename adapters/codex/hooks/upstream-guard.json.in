{
  "description": "Inactive template: review absolute paths, root scope, catalog and native trust before use.",
  "hooks": {
    "PreToolUse": [{
      "matcher": "Bash|exec_command|apply_patch|Write|Edit|MultiEdit|NotebookEdit",
      "hooks": [{
        "type": "command",
        "command": "@@PRE_COMMAND@@",
        "timeout": 8
      }]
    }],
    "PostToolUse": [{"matcher": ".*", "hooks": [{"type": "command", "command": "@@POST_COMMAND@@", "timeout": 8}]}]
  }
}
