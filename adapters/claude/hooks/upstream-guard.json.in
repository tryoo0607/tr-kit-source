{
  "description": "Inactive Linux template: onFailure requires Claude Code >=2.1.295; actual runtime unverified.",
  "hooks": {
    "PreToolUse": [{
      "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
      "hooks": [{
        "type": "command",
        "command": "@@PRE_COMMAND@@",
        "timeout": 8,
        "onFailure": "block"
      }]
    }],
    "PostToolUse": [{"matcher": ".*", "hooks": [{"type": "command", "command": "@@POST_COMMAND@@", "timeout": 8}]}],
    "PostToolUseFailure": [{"matcher": ".*", "hooks": [{"type": "command", "command": "@@FAILURE_COMMAND@@", "timeout": 8}]}]
  }
}
