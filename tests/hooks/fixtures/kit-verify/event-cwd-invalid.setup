repo="$SB/projects/{{KIT_REPO}}"
mkdir -p "$repo/recipes" "$repo/core/contracts" "$repo/tools"
git -C "$repo" init -q -b main 2>/dev/null
printf 'schema_version = 1\n' > "$repo/recipes/_schema.toml"
printf 'schema_version = 1\n' > "$repo/core/contracts/pack-v1.toml"
printf '# fixture\n' > "$repo/tools/build.py"
printf 'raise SystemExit("fixture event cwd failed")\n' > "$repo/tools/validate.py"
git -C "$repo" add -A >/dev/null 2>&1
git -C "$repo" -c user.email=t@t -c user.name=t commit -qm init >/dev/null 2>&1
printf 'dirty\n' > "$repo/scratch.txt"
printf '%s' "$SB" > "$SB/.cwd"
