mkdir -p "$SB/{{TRANSCRIPT_ROOT}}"
if [ "$TARGET" = claude ]; then
  printf '%s\n' '{"type":"assistant","message":{"usage":{"input_tokens":120000,"cache_creation_input_tokens":0,"cache_read_input_tokens":0}}}' > "$SB/{{TRANSCRIPT_ROOT}}/rollout-context-prepare.jsonl"
else
  printf '%s\n' '{"type":"event_msg","payload":{"type":"token_count","info":{"model_context_window":1000,"last_token_usage":{"input_tokens":600}}}}' > "$SB/{{TRANSCRIPT_ROOT}}/rollout-context-prepare.jsonl"
fi
